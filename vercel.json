{
  "functions": {
    "api/public-page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/match-sheet.js": {
      "includeFiles": "server/assets/match-sheet-logo.jpg",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/",
      "dest": "/api/public-page?path=/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/public-page?path=/$1"
    }
  ]
}
