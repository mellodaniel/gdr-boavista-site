{
  "functions": {
    "api/public-page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/match-sheet.js": {
      "includeFiles": "server/assets/match-sheet-logo.jpg",
      "maxDuration": 30
    },
    "api/match-sheet-transcribe.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/mapa-jogos(?:/gestao/[^/]+)?/?",
      "headers": {
        "Referrer-Policy": "no-referrer",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "dest": "/mapa-jogos/index.html"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/",
      "dest": "/api/public-page?path=/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/public-page?path=/$1"
    }
  ]
}
